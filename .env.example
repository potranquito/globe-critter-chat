# Copy this file to .env.local and fill in real values for local dev.
# In Vercel, set these as Environment Variables in Project Settings.
# All VITE_* vars are exposed to the browser bundle — restrict them at the
# provider (HTTP referrer / API scopes) rather than relying on secrecy.

# Google Maps Platform (Maps JS, Places, Geocoding, etc.)
# Restrict to your deployed domain via HTTP referrer in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Cesium Ion access token (for 3D globe/terrain in CesiumGlobe.tsx)
# Get from https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# OpenAI (used by education / habitat resolver services)
VITE_OPENAI_API_KEY=

# eBird
VITE_EBIRD_API_KEY=

# Protected Planet
VITE_PROTECTED_PLANET_KEY=
